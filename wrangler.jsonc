{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beanbean-mouse",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",

  // 后端数据库（Cloudflare D1，SQLite）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beanbeanmouse-db",
      "database_id": "0d3575be-e041-4cb5-a91b-df62b823ef54",
      "migrations_dir": "migrations"
    }
  ],

  // 附件/商品图对象存储：R2 已开通、桶 beanbeanmouse-files 已创建（2026-09-30）。
  // 注意：本项目由 wrangler 配置管理，控制台的绑定界面是只读的，绑定必须写在这里。
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "beanbeanmouse-files" }],

  // 邮件发送：Pages 配置不支持 send_email 绑定，改由 workers/mailer 这个 Worker 持有绑定，
  // Pages Functions 通过 service binding 调用它（见 workers/mailer/README）。
  "services": [{ "binding": "MAILER", "service": "beanbeanmouse-mailer" }],

  "vars": {
    // 非敏感配置；密钥类请用 `npx wrangler pages secret put <NAME> --project-name beanbean-mouse`
    // 邮件通道：service=Cloudflare Email（需外币订阅，暂不可用）/ aliyun=阿里云邮件推送（当前使用）
    "MAIL_TRANSPORT": "aliyun",
    // 邮件通道真正可用后才置 "1"：它会开启"忘记密码"自助入口（半开通时不显示，免得用户收不到信）
    // 新钥匙（RAM 用户 208671990606451044）已授权并实测发信成功（2026-09-28），开启"忘记密码"入口
    "MAIL_READY": "1",
    // 阿里云邮件推送（DirectMail）：AccessKey 存在 Pages Secret 里，这里只放非敏感项
    "ALIYUN_DM_ACCOUNT": "no-reply@mail.beanbeanmouse.com",
    "ALIYUN_DM_FROM_ALIAS": "BeanBeanMouse",
    "ALIYUN_DM_REPLY_TO": "beanbeanmouse.trade@outlook.com",
    "ALIYUN_DM_REGION": "cn-hangzhou",
    "MAIL_FROM": "no-reply@mail.beanbeanmouse.com",
    "APP_URL": "https://beanbeanmouse.com",
    // 邮件通道（阿里云）已开通并实测发信成功，2026-09-28 起新注册必须完成邮箱验证才能登录。
    // 需要临时放开时改回 "0" 即可，代码无需改动。
    "REQUIRE_EMAIL_VERIFY": "1",
    // 2026-09-28 起：邮箱验证已开通，改用它挡机器人邮箱；人工审核关闭，
    // 真实客户注册后点一下验证链接即可登录（可疑账号由管理员在用户列表里一键冻结）。
    "REQUIRE_ACCOUNT_REVIEW": "0",
    "NEWS_AUTO_REFRESH": "0",
    "PBKDF2_ITERATIONS": "100000",
    // 登录态有效期（秒）：默认 7 天，避免"用着用着被踢回登录页"
    "TOKEN_TTL_SEC": "604800",
    // 管理员登录单独限流（每 IP / 15 分钟），防暴力破解
    "ADMIN_LOGIN_LIMIT": "8"
  }
}
