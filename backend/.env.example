# 复制为 .env 并按需修改（docker compose 会自动读取）
PORT=8787
JWT_SECRET=please-change-me-to-a-long-random-string
APP_URL=https://beanbeanmouse.com
# 生产环境建议填写允许的前端域名（逗号分隔取第一个；默认 * 仅限开发）
ALLOWED_ORIGINS=
# 注册/登录限流（每分钟每 IP）
REGISTER_LIMIT=5
LOGIN_LIMIT=10
TRANSLATION_DAILY_QUOTA=5000
TRANSLATION_PROVIDER=chain
# 真实翻译主通道（DeepL）：填上密钥后 chain 模式会优先使用
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
# TRANSLATION_PROVIDER=deepl 表示仅用 DeepL（未配置密钥会报 503）

# 资讯 RSS 自动刷新：1 开启（默认）/ 0 关闭；NEWS_AUTO_REFRESH_MS 为间隔毫秒（默认 6 小时，最短 60 秒）
NEWS_AUTO_REFRESH=1
NEWS_AUTO_REFRESH_MS=21600000

MAIL_TRANSPORT=mock
# 真实邮件通道：MAIL_TRANSPORT=smtp 并填写以下凭据
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
MAIL_FROM=no-reply@beanbeanmouse.local

MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
