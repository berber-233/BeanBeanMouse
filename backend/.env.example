# 复制为 .env 并按需修改（docker compose 会自动读取）
PORT=8787
JWT_SECRET=please-change-me-to-a-long-random-string
TRANSLATION_DAILY_QUOTA=5000
TRANSLATION_PROVIDER=chain
# 真实翻译主通道（DeepL）：填上密钥后 chain 模式会优先使用
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
# TRANSLATION_PROVIDER=deepl 表示仅用 DeepL（未配置密钥会报 503）

MAIL_TRANSPORT=mock
# 真实邮件通道：MAIL_TRANSPORT=smtp 并填写以下凭据
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
MAIL_FROM=no-reply@beanbeanmouse.local

MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
